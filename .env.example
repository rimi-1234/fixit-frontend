# Backend API base URL (no trailing slash). Points at FixItNowPro (Express + Prisma).
# Local:    http://localhost:5000/api
# Deployed: https://fix-it-now-123.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Stripe publishable key (safe for the browser). Only needed if we add Stripe.js/Elements
# on top of the Checkout redirect flow — the redirect flow itself does not require this.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public base URL of THIS frontend app. Also give this value to the backend as its
# FRONTEND_URL env var so Stripe/SSLCommerz redirects land back on our pages.
# Local:    http://localhost:3000
# Deployed: https://fixit-frontend-umber.vercel.app  (must match your Vercel domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — add BOTH local and production URLs in Google Cloud Console:
# JavaScript origins:  http://localhost:3000, https://fixit-frontend-umber.vercel.app
# Redirect URIs:       http://localhost:3000/api/auth/google/callback
#                      https://fixit-frontend-umber.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
